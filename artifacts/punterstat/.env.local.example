# ============================================================
# PunterStat — Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# Never commit real secret values to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://punterstat.site

# ── Supabase (Database & Auth) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (Media & Avatars) ─────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend (Transactional Email) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@punterstat.site

# ── Payments: Stripe (GBP) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ── Payments: Paystack (NGN) ─────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_PRO_PLAN_CODE=

# ── Payments: Remita (NGN Bank / RRR) ────────────────────────
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=
REMITA_BASE_URL=https://remitademo.net

# ── Sports & Market Data Providers ───────────────────────────
ODDS_API_KEY=
SPORTSAPIPRO_API_KEY=
FOOTBALL_DATA_API_KEY=
FOOTBALLDATA_IO_API_KEY=
SPORTRADAR_API_KEY=
SPORTRADAR_ENV=trial
SPORTRADAR_LOCALE=en

# ── Cloudflare R2 (Historical Data Lake & Logs) ──────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# ── Kaggle (International Football Dataset Sync) ─────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Rate Limiting (Upstash Redis — optional, falls back to memory) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error Monitoring (Sentry — optional, no-op when unset) ───
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Cron & Script Helpers ────────────────────────────────────
CRON_SECRET=
LEAGUE=
