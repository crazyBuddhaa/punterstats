# ============================================================
# PunterStat — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------ Supabase ------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------ Cloudinary ------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ------ Resend (email) ------
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@punterstat.site

# ------ App ------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PunterStat

# ------ Cron protection ------
# Vercel sets this automatically on cron requests.
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ------ Cloudflare R2 (dataset storage) ------
# Used to archive raw historical CSVs and serve the dataset layer.
#
# How to get these values:
#   1. Log in to dash.cloudflare.com
#   2. CLOUDFLARE_ACCOUNT_ID: shown in the right sidebar of the dashboard home page
#   3. Create an R2 bucket (R2 Object Storage → Create bucket → e.g. "punterstat-data")
#   4. CLOUDFLARE_R2_BUCKET_NAME: the bucket name you chose (e.g. "punterstat-data")
#   5. Create R2 API credentials:
#      R2 Object Storage → Manage R2 API Tokens → Create API Token
#      Permissions: Object Read & Write
#      Copy the Access Key ID and Secret Access Key shown (they only appear once)
#
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=punterstat-data

# ------ Quant Layer: Odds & Sports Data ------
# The Odds API — 500 credits/month. https://the-odds-api.com
ODDS_API_KEY=your-odds-api-key
# football-data.org — 10 req/min, no monthly cap, secondary/fallback fixture source.
FOOTBALL_DATA_API_KEY=your-football-data-api-key
# footballdata.io — 1000 req/month, primary live fixture source.
FOOTBALLDATA_IO_API_KEY=your-footballdata-io-api-key

# ------ Kaggle (dataset downloads) ------
# Used by POST /api/r2/kaggle to download datasets server-side.
# Get your key: kaggle.com → Account → Settings → API → Create New Token
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# ------ Sportradar Soccer v4 ------
# Real-time fixtures, match stats (xG, possession, shots), probabilities, H2H, player data.
# Get a trial key (free): developer.sportradar.com → My Account → Apps → Create new app → Soccer v4
# Trial: 1 req/s, ~1,000 calls/day, top 5–10 leagues only.
# Production key unlocks all 1,000+ competitions and higher rate limits.
SPORTRADAR_API_KEY=your-sportradar-api-key

# ------ Stripe ------
# Dashboard: https://dashboard.stripe.com
# 1. Get your secret key from Developers → API keys
# 2. Create two Products (Premium £9/mo, Pro £19/mo) and copy their Price IDs
# 3. Set up a webhook endpoint pointing to https://punterstat.site/api/webhooks/stripe
#    Events to listen for: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed
# 4. Copy the webhook signing secret shown after creation
# 5. Configure the Customer Portal at https://dashboard.stripe.com/settings/billing/portal
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# ------ Paystack ------
# Dashboard: https://dashboard.paystack.com
# 1. Get your secret key from Settings → API Keys & Webhooks
# 2. Create two Plans (PunterStat Premium ₦15,000/mo, PunterStat Pro ₦32,000/mo)
#    and copy their plan codes (e.g. PLN_xxx)
# 3. Set your webhook URL to https://punterstat.site/api/webhooks/paystack
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PREMIUM_PLAN_CODE=PLN_...
PAYSTACK_PRO_PLAN_CODE=PLN_...

# ------ Remita ------
# Portal: https://login.remita.net (live) / https://remitademo.net (demo)
# 1. Register as a biller at https://login.remita.net
# 2. Get your Merchant ID and API Key from the biller dashboard
# 3. Create a service type for subscription payments and note the Service Type ID
# 4. Set your payment notification URL to https://punterstat.site/api/webhooks/remita
# 5. Switch REMITA_BASE_URL to https://login.remita.net for live payments
REMITA_MERCHANT_ID=your-remita-merchant-id
REMITA_API_KEY=your-remita-api-key
REMITA_SERVICE_TYPE_ID=your-remita-service-type-id
REMITA_BASE_URL=https://remitademo.net
