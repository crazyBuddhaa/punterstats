{
  "name": "punterstat-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter punterstat run dev",
    "build": "pnpm --filter punterstat run build",
    "lint": "pnpm --filter punterstat run lint",
    "test": "pnpm --filter punterstat run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check-migrations": "pnpm --filter punterstat-scripts run check-migrations"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.18",
      "browserslist": ">=4.28.7",
      "source-map-js": ">=1.2.2",
      "brace-expansion@<2.0.0": ">=1.1.21 <2.0.0",
      "js-yaml": ">=4.3.2",
      "baseline-browser-mapping": ">=2.11.0",
      "postcss-selector-parser": ">=6.1.5",
      "glob@>=9.0.0": ">=14.0.2",
      "minimatch@>=7.0.0": ">=11.0.1"
    }
  }
}
